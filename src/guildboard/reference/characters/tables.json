        "tier3": 2.418,
        "tier4": 0.62,
        "tier5": 0.062
      },
      "boss": {
        "unit": "a world boss's own material per kill at world level 8 (40 resin; 2 plus 55.56%)"
      },
      "weekly": {
        "unit": "the expected number of each of a weekly boss's three materials per claim at world level 8 (30 resin the first three claims a week, then 60)",
        "total_of_the_three": 2.4,
        "split": "assumed even among the three materials; the sources give only the total"
      },
      "ley_exp": {
        "unit": "average Character EXP from one Blossom of Revelation claim at world level 6 and up (20 resin or one condensed resin): 6 to 7 Adventurer's Experience and 4 to 5 Hero's Wit"
