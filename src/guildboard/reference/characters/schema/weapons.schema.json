{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "weapons.json: each 4-star and 5-star weapon's base stats at level 90 and its counted effects, by weapon key",
  "type": "object",
  "required": ["weapons", "checked", "sources"],
  "additionalProperties": false,
  "properties": {
    "checked": {"type": ["string", "null"]},
    "sources": {"type": "array"},
    "weapons": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "type", "rarity", "base_atk_90", "sub", "sub_90", "effects"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["Sword", "Claymore", "Polearm", "Bow", "Catalyst"]},
          "rarity": {"type": "integer", "minimum": 1, "maximum": 5},
          "base_atk_90": {"type": "number", "minimum": 0},
          "sub": {"type": ["string", "null"], "enum": ["hp", "atk", "def", "hp_pct", "atk_pct", "def_pct", "em", "er", "cr", "cd", "dmg", "heal", "phys", null]},
          "sub_90": {"type": "number", "minimum": 0},
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stat", "values", "when"],
              "additionalProperties": false,
              "properties": {
                "stat": {"enum": ["hp", "atk", "def", "hp_pct", "atk_pct", "def_pct", "em", "er", "cr", "cd", "dmg", "heal", "phys"]},
                "values": {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 5},
                "when": {"enum": ["always", "met"]},
                "condition": {"type": "string"}
              }
            }
          },
          "icon": {"type": ["string", "null"]},
          "entry": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
